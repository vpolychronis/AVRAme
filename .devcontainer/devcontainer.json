{
    "name": "AVRA ROS 2 Humble",
    "dockerComposeFile": "../compose.yaml",
    "service": "ros_dev",
    "workspaceFolder": "/home/ros/avra_ws",

    // Enter the container as the 'ros' user
    "remoteUser": "ros",

    // Essential VS Code Extensions for ROS 2 Development
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-iot.vscode-ros",
                "smilerobotics.urdf"
            ],
            // Standard VS Code settings for this workspace
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },

    // Ensures X11/GUI apps work well
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },

    // Set permissions correctly after attaching
    "postStartCommand": "sudo chown -R ros:ros /home/ros/avra_ws"    
}
